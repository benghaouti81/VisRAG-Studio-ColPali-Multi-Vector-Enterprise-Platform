# GEMINI_API_KEY: Required for Gemini Multimodal Grounding (gemini-3.8-flash)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host URL for self-referential links and endpoints
APP_URL="MY_APP_URL"

# Hardware Device Configuration (cuda, cpu, mps)
DEVICE="cpu"

# Web and API Ports
PORT=3000
BACKEND_PORT=8000

# Vector Database (Qdrant)
USE_QDRANT="false"
QDRANT_URL="http://localhost:6333"
